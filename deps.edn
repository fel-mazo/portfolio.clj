{:paths ["src" "resources" "test"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        hiccup/hiccup {:mvn/version "2.0.0-RC4"}
        markdown-clj/markdown-clj {:mvn/version "1.12.2"}
        org.slf4j/slf4j-simple {:mvn/version "2.0.9"}
        ring/ring-core {:mvn/version "1.12.2"}
        ring/ring-jetty-adapter {:mvn/version "1.12.2"}}
 :aliases
 {:run {:main-opts ["-m" "portfolio.core"]}
  :export {:main-opts ["-m" "portfolio.export"]}
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
          :main-opts ["-m" "nrepl.cmdline" "--bind" "127.0.0.1" "--port" "7888"]}
  :test {:extra-paths ["test"]
         :main-opts ["-m" "portfolio.test-runner"]}}}
